# Local working notes — never committed.
CLAUDE.md
# Private business files (agreements, signature, payment QR codes) — never committed.
work/

# ---- Vendored / fetched dependencies ----
# MAME, SDL3, SoftFloat, Musashi, Dear ImGui etc. Separate repositories with
# their own history and licences; fetched and pinned, never committed.
extern/
# (third_party/quest: the Quest app's SDL2 headers, OpenXR loader and voice libraries, fetched by scripts/quest_tools.py)
third_party/
# the Quest app's build (scripts/build_quest.py)
build_quest/
# the iOS app's Xcode project, made by xcodegen beside its spec (scripts/build_apple.py)
src/flat/ios/*.xcodeproj/
# ...and the Apple TV app's (scripts/build_tvos.py)
src/flat/tvos/*.xcodeproj/
# the Vision Pro app's, and its libraries (scripts/build_visionos.py)
src/visionos/*.xcodeproj/
build_visionos/
vendor/

# ---- ROMs and anything derived from them — LEGAL, not tidiness ----
# Players supply their own ROM set (hotd.zip). No ROM bytes, no de-interleaved
# image, no generated C++, no extracted assets enter this repository.
*.zip
*.7z
*.rom
*.bin
*.ic*
# (but the app icons: scripts/make_icons.py, and the site favicon: site/tools/media.py)
!src/flat/win/hotdvr.ico
!src/flat/mac/AppIcon.icns
!site/public/favicon.ico
roms/*
!roms/.gitkeep
rom/
generated/
extracted/

# ---- Analysis working files ----
# seeds.toml IS committed (our own naming work). Ghidra state, MAME traces
# and display-list dumps reproduce game data and are not.
*.gpr
*.rep/
*.gzf
ghidra_*/
traces/
dumps/
*.m2tr
*.m2in

# ---- Build output ----
build/
build-*/
# One folder per game (scripts/games.py): recompilation, desktop and Vita builds.
build_*/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
compile_commands.json
*.o
*.a
*.so
*.dll
*.dylib
*.exe
*.pdb
*.obj
*.lib
.ninja_deps
.ninja_log
shadercache/
*.spv

# ---- Editor / OS ----
.idea/
*.swp
*~
.DS_Store
__pycache__/
*.pyc
