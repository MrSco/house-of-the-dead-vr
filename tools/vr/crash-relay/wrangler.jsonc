// House of the Dead VR's Worker (README.md): serves the website (site/public/) and the crash relay
// at https://hotdvr.roccojuliano.com (/v1/reports, /v1/health).
// Deploy: npx wrangler deploy (the account is the logged-in one: no account id here); secrets:
// npx wrangler secret put GITHUB_TOKEN (and optionally REPORT_KEY).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hotd-crash-relay",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "../../../site/public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/v1/*", "/report"]
  },
  // its own subdomain of the user's zone (Cloudflare makes the DNS record and the certificate)
  "routes": [{ "pattern": "hotdvr.roccojuliano.com", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    // the private repository the crash issues go to
    "GITHUB_REPO": "MrSco/house-of-the-dead-vr-crashes",
    // new crash issues (new signatures) accepted per 24 hours; occurrences of known crashes are always counted
    "NEW_ISSUES_PER_DAY": "20"
  },
  // per-address and overall limits (period: 10 or 60 seconds). An app sends at most 5 reports per start.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "4711", "simple": { "limit": 6, "period": 60 } },
    { "name": "GLOBAL_LIMITER", "namespace_id": "4712", "simple": { "limit": 30, "period": 60 } }
  ]
}
