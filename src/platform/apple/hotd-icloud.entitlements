<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- iCloud for the Apple apps (iPhone and iPad, Apple TV, Vision Pro): docs/icloud-sync.md. Used only when a build
     script runs with HOTD_ICLOUD=1 and signs (never the simulator): the App ID needs the iCloud capability (CloudKit)
     with this container, and the profile has to be made after that. scripts/build_tvos.py adds aps-environment for
     the Apple TV (App Store Connect refuses tvOS iCloud without it: error 90575). -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.mrsco.hotdvr</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)com.mrsco.hotdvr</string>
</dict>
</plist>
